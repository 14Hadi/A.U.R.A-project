# ============================================================================
# KONFIGURASI LINGKUNGAN SERVER A.U.R.A (Automated Universal Routine Assistant)
# ============================================================================

# GEMINI_API_KEY: Wajib untuk pemanggilan Gemini API di sisi server (server.ts).
# Di Google AI Studio, kunci ini disuntikkan otomatis dari panel Settings > Secrets.
# PENTING: Jangan pernah mengekspos variabel ini dengan awalan VITE_ agar tidak
# bocor ke bundle browser klien.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL tempat aplikasi di-host (disuntikkan otomatis saat runtime).
APP_URL="MY_APP_URL"

# Catatan Konfigurasi Google OAuth 2.0 Client ID:
# Kredensial publik klien Google Sign-In & Firebase Auth (termasuk oAuthClientId)
# dimuat secara otomatis dari berkas /firebase-applet-config.json di sisi klien.
